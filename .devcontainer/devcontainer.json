{
  "name": "clearnote-py-da",
  // 🐳 Imagen base de Dev Containers (incluye VS Code + Python)
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // 📂 Carpeta de trabajo dentro del contenedor
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // ⚙️ Personalizaciones adicionales
  "customizations": {
    "vscode": {
      "settings": {
        // --- Ruff: El nuevo estándar de formateo y limpieza ---
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.inlayHints.variableTypes": true,
        "python.analysis.inlayHints.functionReturnTypes": true,
        "editor.wordWrap": "on",
        "workbench.iconTheme": "material-icon-theme"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",        // Sustituye a Black, Isort y Flake8
        "ms-toolsai.jupyter",        // Vital para probar transformaciones rápidas
        "tamasfe.even-better-toml",  // Configuración de herramientas modernas
        "github.copilot",            // Tu copiloto de IA
        "christian-kohler.path-intellisense",
        "pkief.material-icon-theme"
      ]
    }
  },
  // 👤 Usuario por defecto en el contenedor
  "remoteUser": "root",
  // 🐍 Se instalan las librerías requeridas para el proyecto
  "postCreateCommand": "pip install -r requirements.txt"
}